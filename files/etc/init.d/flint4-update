#!/bin/sh /etc/rc.common
# After an update by flint4-update, check the router once it has booted and
# roll back if it is not healthy. Does nothing on an ordinary boot.

START=99
USE_PROCD=1

start_service() {
	[ -f /etc/flint4-update/pending ] || [ -f /etc/flint4-update/rolledback ] || return 0
	procd_open_instance health
	procd_set_param command /usr/sbin/flint4-update health
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
